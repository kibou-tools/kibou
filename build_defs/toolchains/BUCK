staged_go_toolchain(
    name = "stage2_stdlib_go",
    assembler = "root//go/src/cmd/asm:stage2",
    base = ":go",
    build_tags = [],
    cgo = "root//go/src/cmd/cgo:stage2",
    compiler = "root//go/src/cmd/compile:stage2",
    go_root = "root//:stage1_goroot",
    linker = "root//go/src/cmd/link:stage2",
    visibility = ["PUBLIC"],
)

# Project packages use the current-source stage-2 tools, but a stable pinned
# GOROOT. The tools are invoked directly with explicit importcfg files, so the
# whole mutable current-source GOROOT must not poison every application action
# key.
staged_go_toolchain(
    name = "final_go",
    assembler = "root//go/src/cmd/asm:stage2",
    base = ":go",
    build_tags = [],
    cgo = "root//go/src/cmd/cgo:stage2",
    compiler = "root//go/src/cmd/compile:stage2",
    compiler_identity_inputs = ["root//build_defs/generated:compiler_identity"],
    go_root = _GO_ROOT,
    linker = "root//go/src/cmd/link:stage2",
    visibility = ["PUBLIC"],
)
